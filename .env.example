# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<your-supabase-url>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-supabase-publishable-key>

# Database
DATABASE_URL=postgresql://<your-database-url>

# ElevenLabs
ELEVENLABS_API_KEY=<your-elevenlabs-api-key>

# OpenAI
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_PROJECT_ID=<your-openai-project-id>

# Mocks
NEXT_PUBLIC_ENCOUNTER_DIALOGUE_MOCK=<true-or-false>
NEXT_PUBLIC_CHITTER_CHAT_MOCK=<true-or-false>
NEXT_PUBLIC_ENCOUNTER_REVIEW_CHAT_MOCK=<true-or-false>
NEXT_PUBLIC_ENCOUNTER_HELPER_MOCK=<true-or-false>
NEXT_PUBLIC_ENCOUNTER_REVIEW_MOCK=<true-or-false>